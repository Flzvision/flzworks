generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String
  name          String
  role          String        @default("USER")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}





model IntranetAccessRequest {
  id                  String    @id @default(cuid())
  module              String    @default("autopiac")
  name                String
  email               String
  ipAddress           String
  status              String    @default("PENDING")
  approveTokenHash    String    @unique
  denyTokenHash       String    @unique
  claimTokenHash      String?   @unique
  approvedAt          DateTime?
  deniedAt            DateTime?
  accessedAt          DateTime?
  expiresAt           DateTime
  grantedDurationDays Int?
  createdAt           DateTime  @default(now())

  @@index([module, ipAddress, status, expiresAt])
  @@index([email, createdAt])
}

model IntranetIpBlock {
  id        String   @id @default(cuid())
  ipAddress String
  reason    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([ipAddress, expiresAt])
}

model PortfolioArticle {
  id          String   @id @default(cuid())
  folderName  String   @unique
  title       String
  description String?
  date        String // extracted from folder name, e.g. "2026-11-17"
  visible     Boolean  @default(true)
  category    String   @default("CAR_DESIGN") // "CAR_DESIGN" or "OTHER"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FlzProject {
  id             String    @id @default(cuid())
  title          String
  tools          String // e.g. "Blender · ZBrush"
  category       String // e.g. "Characters", "Automotive", "Gameplay", "Assets"
  publishedAt    DateTime? // when the work was made; rendered as "3 months ago"
  gradient       String? // radial gradient or color preset
  body           String? // article text shown on the card
  featured       Boolean   @default(false)
  visible        Boolean   @default(true)
  sortOrder      Int       @default(0)
  linkUrl        String? // external link or demo URL
  imageUrl       String? // custom media URL
  socialPlatform String? // imported source, e.g. "instagram" or "tiktok"
  socialPostId   String? // provider-owned post ID used for duplicate-proof syncing
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([socialPlatform, socialPostId])
  @@index([visible, sortOrder])
  @@index([category])
}

model FlzSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model FlzContactMessage {
  id        String   @id @default(cuid())
  name      String?
  email     String?
  message   String
  source    String   @default("portfolio")
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
}

// Consent-based, first-party audience measurement. No IP address, user agent,
// referrer, account ID, cookie ID, or cross-site identifier is stored.
model TelemetrySession {
  id         String           @id
  site       String
  path       String
  startedAt  DateTime         @default(now())
  lastSeenAt DateTime         @default(now())
  endedAt    DateTime?
  durationMs Int              @default(0)
  events     TelemetryEvent[]

  @@index([site, startedAt])
  @@index([lastSeenAt])
}

model TelemetryEvent {
  id         String           @id @default(cuid())
  sessionId  String
  session    TelemetrySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  site       String
  type       String
  label      String?
  dedupeKey  String?          @unique
  occurredAt DateTime         @default(now())

  @@index([site, type, occurredAt])
  @@index([sessionId, occurredAt])
}
