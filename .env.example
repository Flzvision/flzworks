DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flzworks?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"
# Only needed to create the admin user on a fresh database; seeding an
# existing admin does not use it.
SEED_ADMIN_PASSWORD=""
GOOGLE_CLIENT_ID="your-google-cloud-oauth-client-id"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="same-as-GOOGLE_CLIENT_ID"
# Local development can keep using ./uploads. Production must use the S3 variables below.
UPLOAD_DIR="./uploads"
S3_BUCKET=""
S3_ENDPOINT="https://storage.railway.app"
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Optional local-only Studio bypass. It is ignored in production.
ALLOW_LOCAL_STUDIO_BYPASS="0"
APP_BASE_URL="http://localhost:3000"
INTRANET_ACCESS_SECRET="replace-with-a-long-random-intranet-secret"
INTRANET_HOST_EMAIL="floszbeni@gmail.com"
GMAIL_SMTP_USER=""
GMAIL_SMTP_APP_PASSWORD=""
GMAIL_SMTP_FROM=""
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_USER_ID=""
INSTAGRAM_API_VERSION="v23.0"
TIKTOK_ACCESS_TOKEN=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REFRESH_TOKEN=""
SOCIAL_SYNC_SECRET="replace-with-a-long-random-secret"
X_BEARER_TOKEN=""
X_USERNAME=""
LINKEDIN_ACCESS_TOKEN=""
LINKEDIN_ORGANIZATION_ID=""
LINKEDIN_API_VERSION="202606"
NEXT_PUBLIC_SOCIAL_INSTAGRAM=""
NEXT_PUBLIC_SOCIAL_FACEBOOK=""
NEXT_PUBLIC_SOCIAL_PINTEREST=""
